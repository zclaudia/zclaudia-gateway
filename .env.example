# Required: admin token for the credential management API (/api/admin/*).
# Issued credentials (zgd_/zgb_) are the only client/backend authentication,
# so this is the root of trust — treat it like a root password.
GATEWAY_ADMIN_TOKEN=your-admin-token-here

# Optional: public base URL, used by scripts/gateway-admin.sh when run from a
# machine other than the gateway host (defaults to http://127.0.0.1:$GATEWAY_PORT).
# GATEWAY_URL=https://gateway.example.com

# Optional: comma-separated CORS origin allowlist. Unset keeps the wildcard.
# GATEWAY_ALLOWED_ORIGINS=https://app.example.com

# Optional: trust X-Forwarded-For — enable only behind a trusted reverse proxy (ADR-0001)
# GATEWAY_TRUST_PROXY=true

# Optional: authenticated proxy requests per tenant (credential) per 60s (default 1200).
# GATEWAY_PROXY_RATE_LIMIT=1200

# Optional: proxy requests per client IP per 60s, summed over all credentials from
# that IP. Off by default; only a coarse brake for one source holding many credentials.
# GATEWAY_PROXY_IP_RATE_LIMIT=3000

# Optional: unauthenticated attempts per client IP per 60s before every route answers
# 429 instead of 401 (default 10). Shared by HTTP 401s and rejected WS handshakes, so
# raise it if many devices behind one NAT can retry a stale credential at once.
# GATEWAY_AUTH_FAIL_RATE_LIMIT=10
