# Required: shared secret for backend registration and client authentication
GATEWAY_SECRET=your-secret-here

# Optional: admin token for the credential management API (/api/admin/*).
# Must differ from GATEWAY_SECRET. Leave unset to disable the admin API.
# GATEWAY_ADMIN_TOKEN=your-admin-token-here

# Optional: comma-separated CORS origin allowlist. Unset keeps the wildcard.
# GATEWAY_ALLOWED_ORIGINS=https://app.example.com

# Optional: trust X-Forwarded-For — enable only behind a trusted reverse proxy (ADR-0001)
# GATEWAY_TRUST_PROXY=true
