{
  "name": "@zclaudia/gateway-protocol",
  "version": "0.2.0",
  "description": "Canonical wire types and constants for Gateway Protocol v4: handshake, registry, heartbeat, control plane, channels, topics, streaming HTTP, plus auth/admin/notification service DTOs. Zero dependencies.",
  "keywords": [
    "gateway",
    "websocket",
    "protocol",
    "zclaudia"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zclaudia/zclaudia-gateway.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "default": "./dist/admin.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "import": "./dist/notifications.js",
      "default": "./dist/notifications.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build"
  }
}
