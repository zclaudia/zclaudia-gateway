{
  "name": "@zclaudia/gateway-protocol",
  "version": "0.1.0",
  "description": "Wire types and constants for Gateway Protocol v4 (channels, topics, streaming HTTP). Zero dependencies.",
  "keywords": [
    "gateway",
    "websocket",
    "protocol",
    "zclaudia"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zclaudia/zclaudia-gateway.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build"
  }
}
